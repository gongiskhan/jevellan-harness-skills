{
  "description": "The ledger's three hooks. Each runs with the node first on PATH, which must be Node 22.13 or later; a hook outside a project set up for the harness (no .jevellan/ folder) and not in a worker does nothing.",
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/jevellan-ledger/hooks/stop.mjs"], "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/jevellan-ledger/hooks/post-tool.mjs"], "timeout": 10 }] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume|compact", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/jevellan-ledger/hooks/session-start.mjs"], "timeout": 10 }] }
    ]
  }
}
