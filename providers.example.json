{
  "jev": {
    "keyFile": "~/.jevellan-harness/secrets/jev.key",
    "model": "jev-latest",
    "timeoutMs": 4000
  },
  "providers": [
    {
      "name": "claude-main",
      "kind": "claude-subscription",
      "tokenFile": "~/.jevellan-harness/secrets/claude-main.token",
      "ceilingPct": 90,
      "models": [
        { "id": "claude-opus-5-5", "label": "Opus", "efforts": ["low", "medium", "high", "xhigh", "max"] },
        { "id": "claude-fable-5-1", "label": "Fable", "efforts": ["low", "medium", "high", "xhigh", "max"] },
        { "id": "claude-sonnet-5-5", "label": "Sonnet", "efforts": ["low", "medium", "high"] },
        { "id": "claude-haiku-5-5", "label": "Haiku", "efforts": ["low", "medium"] }
      ]
    },
    {
      "name": "claude-second",
      "kind": "claude-subscription",
      "tokenFile": "~/.jevellan-harness/secrets/claude-second.token",
      "ceilingPct": 90,
      "models": "same as claude-main"
    },
    {
      "name": "codex",
      "kind": "codex-subscription",
      "ceilingPct": 90,
      "models": [
        { "id": "gpt-6-astra", "label": "GPT", "efforts": ["low", "medium", "high", "xhigh"] }
      ]
    },
    {
      "name": "deepseek-rtx",
      "kind": "claude-endpoint",
      "baseUrl": "https://llm-rtx.culturabuilder.com",
      "keyFile": "~/.config/cultura-builder-llm/rtx-litellm-key",
      "placement": false,
      "metered": false,
      "projects": ["~/dev/jevellan-harness-skills"],
      "env": {
        "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4.1-flash-1017-uncensored",
        "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "65536",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432",
        "API_TIMEOUT_MS": "1800000",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
        "MAX_THINKING_TOKENS": "0",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
      },
      "models": [
        { "id": "deepseek-v4.1-flash-1017-uncensored", "label": "DeepSeek V4.1 Flash", "efforts": ["low", "medium", "high", "max"] }
      ]
    },
    {
      "name": "glm",
      "kind": "claude-endpoint",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "keyFile": "~/.jevellan-harness/secrets/glm.key",
      "models": [
        { "id": "glm-5.3", "label": "GLM", "efforts": ["low", "medium", "high"] }
      ]
    }
  ]
}
